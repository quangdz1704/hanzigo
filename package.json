{
  "name": "hanzigo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:auth": "firebase emulators:exec --only auth --project demo-hanzigo 'vitest run --config vitest.auth.config.ts'",
    "test:rules": "firebase emulators:exec --only firestore --project demo-hanzigo 'vitest run --config vitest.rules.config.ts'",
    "test:profiles": "firebase emulators:exec --only auth,firestore --project demo-hanzigo 'vitest run --config vitest.profiles.config.ts'",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "content:import": "node --import tsx scripts/import-content.ts",
    "format": "prettier --write src scripts tests *.ts *.json *.md docs",
    "firebase:seed": "node --import tsx scripts/seed-firebase-content.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "firebase": "^12.4.0",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.0",
    "firebase-tools": "^14.20.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.0"
  }
}
