rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/config/admins) && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function account(uid) { return own(uid) && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    match /content/library {
      allow get: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['raw','updatedBy','updatedAt'])
        && request.resource.data.raw is string && request.resource.data.raw.size() > 0 && request.resource.data.raw.size() <= 800000
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }
    match /users/{uid} {
      allow get: if account(uid) || admin();
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid','name','email','createdAt','updatedAt'])
          && d.uid == uid && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && d.email == request.auth.token.get('email', null)
          && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      allow create: if account(uid) && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if account(uid) && validProfile() && request.resource.data.createdAt == resource.data.createdAt;
      allow list, delete: if false;
      match /{kind}/{id} {
        allow get, list: if account(uid) && kind in ['cards','progress','activities','reviews','favorites','preferences','drafts','studyDays','quizAnswers','musicPlaylists'] && (kind != 'drafts' || admin());
        function fields(v, keys) { return v.keys().hasOnly(keys) && v.keys().hasAll(keys); }
        function validPreference(v) {
          return fields(v, ['id','value','updatedAt']) && v.updatedAt is number && v.updatedAt >= 0
            && (v.id in ['autoLetters','pinyin','translation','sound'] && v.value is bool
              || v.id == 'fontSize' && v.value is number && v.value >= 20 && v.value <= 36
              || v.id == 'theme' && v.value in ['light','dark','system']
              || v.id == 'recipientUid' && admin() && v.value is string && v.value.size() <= 128
              || v.id == 'quizDisplay' && v.value is map && fields(v.value, ['hanzi','pinyin','vietnamese']) && v.value.hanzi is bool && v.value.pinyin is bool && v.value.vietnamese is bool && (v.value.hanzi || v.value.pinyin || v.value.vietnamese));
        }
        function validContentId(v) { return v is string && v.size() > 0 && v.size() <= 100; }
        function validReviewIds(ids) {
          return ids is list && ids.size() <= 5
            && (ids.size() < 1 || validContentId(ids[0]))
            && (ids.size() < 2 || validContentId(ids[1]))
            && (ids.size() < 3 || validContentId(ids[2]))
            && (ids.size() < 4 || validContentId(ids[3]))
            && (ids.size() < 5 || validContentId(ids[4]))
            && ids.toSet().size() == ids.size();
        }
        function validStudyDay(v) {
          return fields(v,['id','storyId','reviewIds','startedAt','readAt','updatedAt'])
            && v.id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && v.id == id
            && validContentId(v.storyId) && validReviewIds(v.reviewIds)
            && v.startedAt is number && v.startedAt >= 0 && v.readAt is number && v.readAt >= 0
            && v.updatedAt is number && v.updatedAt >= 0;
        }
        function validQuizAnswer(v) {
          return fields(v,['id','attemptId','storyId','questionId','version','choice','answer','source','at'])
            && v.attemptId is string && v.attemptId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
            && validContentId(v.storyId) && validContentId(v.questionId)
            && v.id == v.attemptId + ':' + v.questionId
            && v.version is string && v.version.size() > 0 && v.version.size() <= 40
            && v.choice is int && v.choice >= 0 && v.choice <= 4
            && v.answer is int && v.answer >= 0 && v.answer <= 4
            && v.source in ['story','mistake'] && v.at is number && v.at >= 0;
        }
        function validValue(v) {
          return v is map && v.id is string && v.id.size() > 0 && v.id.size() <= 250
            && (kind == 'musicPlaylists' && v.keys().hasOnly(['id','name','raw','deleted','updatedAt','visibility']) && v.keys().hasAll(['id','name','raw','deleted','updatedAt']) && v.get('visibility','private') in ['private','public'] && v.id == id && v.id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$') && v.name is string && v.name.size() > 0 && v.name.size() <= 80 && v.raw is string && v.raw.size() <= 50000 && v.deleted is bool && v.updatedAt is number && v.updatedAt >= 0
              || kind == 'studyDays' && validStudyDay(v)
              || kind == 'quizAnswers' && validQuizAnswer(v)
              || kind == 'cards' && fields(v,['id','dueAt','interval','repetitions','addedAt','updatedAt']) && v.dueAt is number && v.dueAt >= 0 && v.interval is number && v.interval >= 0 && v.interval <= 365 && v.repetitions is int && v.repetitions >= 0 && v.addedAt is number && v.addedAt >= 0 && v.updatedAt is number && v.updatedAt >= 0
              || kind == 'progress' && v.keys().hasOnly(['id','sentence','completed','quizScore','updatedAt']) && v.keys().hasAll(['id','sentence','completed','updatedAt']) && v.sentence is int && v.sentence >= 0 && v.sentence < 900 && v.completed is bool && v.get('quizScore',0) is int && v.get('quizScore',0) >= 0 && v.get('quizScore',0) <= 10 && v.updatedAt is number && v.updatedAt >= 0
              || kind == 'favorites' && fields(v,['id','active','updatedAt']) && v.active is bool && v.updatedAt is number && v.updatedAt >= 0
              || kind == 'reviews' && fields(v,['id','cardId','rating','at']) && v.cardId is string && v.rating in ['again','hard','good','easy'] && v.at is number && v.at >= 0
              || kind == 'activities' && fields(v,['id','kind','day','xp','at']) && v.day is string && v.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && v.at is number && v.at >= 0 && (v.kind == 'story' && v.xp == 30 || v.kind == 'quiz' && v.xp == 15 || v.kind == 'review' && v.xp == 5 || v.kind == 'game' && v.xp == 10)
              || kind == 'preferences' && validPreference(v)
              || kind == 'drafts' && admin() && fields(v,['id','raw','updatedAt']) && v.raw is string && v.raw.size() <= 500000 && v.updatedAt is number && v.updatedAt >= 0);
        }
        function musicPublicationMatches(v) {
          let path = /databases/$(database)/documents/publicMusicPlaylists/$(uid + '_' + id);
          return (v.get('visibility','private') == 'public' && !v.deleted)
            ? existsAfter(path) && getAfter(path).data.ownerUid == uid && getAfter(path).data.playlistId == id
              && getAfter(path).data.name == v.name && getAfter(path).data.raw == v.raw
              && getAfter(path).data.sourceUpdatedAt == v.updatedAt
            : !existsAfter(path);
        }
        function validRecord() { return fields(request.resource.data, ['value','updatedAt']) && request.resource.data.updatedAt == request.time && validValue(request.resource.data.value)
          && (kind != 'musicPlaylists' || musicPublicationMatches(request.resource.data.value)); }
        allow create: if account(uid) && validRecord();
        allow update: if account(uid) && validRecord() && request.resource.data.value.id == resource.data.value.id
          && (!(kind in ['activities','reviews','quizAnswers']) || request.resource.data.value == resource.data.value)
          && (kind != 'progress' || (!resource.data.value.completed || request.resource.data.value.completed) && request.resource.data.value.get('quizScore',0) >= resource.data.value.get('quizScore',0));
        allow delete: if false;
      }
    }
    match /publicMusicPlaylists/{publicId} {
      allow get, list: if true;
      function validPublicMusic(d) {
        let source = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/musicPlaylists/$(d.playlistId)).data.value;
        return d.keys().hasOnly(['playlistId','ownerUid','authorName','name','raw','sourceUpdatedAt','updatedAt'])
          && d.keys().hasAll(['playlistId','ownerUid','authorName','name','raw','sourceUpdatedAt','updatedAt'])
          && d.ownerUid == request.auth.uid && publicId == d.ownerUid + '_' + d.playlistId
          && d.authorName == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 40
          && source.get('visibility','private') == 'public' && !source.deleted
          && source.id == d.playlistId && source.name == d.name && source.raw == d.raw
          && source.updatedAt == d.sourceUpdatedAt && d.updatedAt == request.time;
      }
      allow create: if signedIn() && account(request.auth.uid) && validPublicMusic(request.resource.data);
      allow update: if signedIn() && account(request.auth.uid) && resource.data.ownerUid == request.auth.uid
        && validPublicMusic(request.resource.data);
      allow delete: if signedIn() && account(request.auth.uid) && resource.data.ownerUid == request.auth.uid
        && (getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/musicPlaylists/$(resource.data.playlistId)).data.value.get('visibility','private') == 'private'
          || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/musicPlaylists/$(resource.data.playlistId)).data.value.deleted);
    }
    function delivered(m) { return signedIn() && m.recipientUid == request.auth.uid && (m.status == 'published' || m.status == 'scheduled' && m.visibleAt <= request.time); }
    function validMessage(m) {
      return m.keys().hasOnly(['recipientUid','title','zhText','pinyin','viText','theme','deliveryType','scheduledAt','milestoneKind','milestoneCount','status','visibleAt','publishedAt','createdAt','updatedAt'])
        && m.keys().hasAll(['recipientUid','title','zhText','pinyin','viText','theme','deliveryType','scheduledAt','milestoneKind','milestoneCount','status','visibleAt','publishedAt','createdAt','updatedAt'])
        && m.recipientUid is string && m.recipientUid.size() > 0 && m.recipientUid.size() <= 128
        && m.title is string && m.title.size() > 0 && m.title.size() <= 120
        && m.viText is string && m.viText.size() > 0 && m.viText.size() <= 5000
        && m.zhText is string && m.zhText.size() <= 500
        && m.pinyin is string && m.pinyin.size() <= 1000
        && (m.pinyin == '' || m.zhText != '')
        && m.theme in ['rose','sage','lavender']
        && m.deliveryType in ['instant','scheduled','milestone']
        && m.status in ['draft','scheduled','published','archived']
        && m.milestoneKind in ['stories','streak','reviews']
        && m.milestoneCount is int && m.milestoneCount >= 1 && m.milestoneCount <= 1000
        && m.visibleAt is timestamp && m.createdAt is timestamp && m.updatedAt == request.time
        && (m.publishedAt == null || m.publishedAt is timestamp && m.publishedAt <= request.time)
        && (m.deliveryType == 'scheduled' ? m.scheduledAt is timestamp && m.visibleAt == m.scheduledAt : m.scheduledAt == null)
        && (m.status != 'scheduled' || m.deliveryType == 'scheduled' && m.visibleAt > request.time)
        && (m.status != 'published' || m.deliveryType != 'scheduled' && m.visibleAt <= request.time)
        && (m.status in ['draft','archived'] || m.publishedAt is timestamp);
    }
    match /config/admins {
      // Bootstrap and modify via Firebase Console / trusted Admin SDK only.
      allow get: if signedIn() && request.auth.uid in resource.data.uids;
      allow list, create, update, delete: if false;
    }
    match /config/settings {
      allow get: if signedIn();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['popupsEnabled']) && request.resource.data.popupsEnabled is bool;
      allow list, delete: if false;
    }
    match /messages/{id} {
      allow get, list: if admin() || delivered(resource.data);
      allow create: if admin() && validMessage(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if admin() && validMessage(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if admin();
    }
    match /devices/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      function validDevice() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid','label','createdAt','lastPing','name','email'])
          && request.resource.data.keys().hasAll(['uid','label','createdAt','lastPing'])
          && request.resource.data.uid == uid && request.resource.data.label is string && request.resource.data.label.size() <= 80
          && request.resource.data.createdAt is timestamp && request.resource.data.lastPing == request.time
          && (!('name' in d) || request.auth.token.firebase.sign_in_provider != 'anonymous' && d.name is string && d.name.size() > 0 && d.name.size() <= 40)
          && (!('email' in d) || d.email == request.auth.token.get('email', null) && (d.email == null || d.email is string && d.email.size() <= 254));
      }
      allow create: if own(uid) && validDevice() && request.resource.data.createdAt == request.time;
      allow update: if own(uid) && validDevice() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      match /receipts/{messageId} {
        allow get, list: if own(uid) || admin();
        function validTime(value) { return value == null || value is timestamp && value <= request.time; }
        function validReceipt() {
          let m = get(/databases/$(database)/documents/messages/$(messageId)).data;
          let r = request.resource.data;
          return r.keys().hasOnly(['recipientUid','messageId','seenAt','readAt','heartedAt','favoritedAt','dismissedAt','updatedAt'])
            && r.keys().hasAll(['recipientUid','messageId','seenAt','readAt','heartedAt','favoritedAt','dismissedAt','updatedAt'])
            && r.recipientUid == uid && r.messageId == messageId
            && m.recipientUid == uid && m.status in ['published','scheduled','archived'] && m.visibleAt <= request.time
            && validTime(r.seenAt) && validTime(r.readAt) && validTime(r.heartedAt) && validTime(r.favoritedAt) && validTime(r.dismissedAt)
            && r.updatedAt == request.time;
        }
        allow create, update: if own(uid) && validReceipt();
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
